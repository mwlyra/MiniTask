<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>MiniTask</AssemblyName><RootNamespace>MiniTask.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>MiniTask.ico</ApplicationIcon>
    <Version>1.1.4</Version><Description>MiniTask local Windows macro recorder</Description>
    <PlatformTarget>x64</PlatformTarget><PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableCompressionInSingleFile Condition="'$(PublishSingleFile)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../MiniTask.Windows/MiniTask.Windows.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="MiniTask.ico" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../docs/runtime-licenses/*.txt" LogicalName="MiniTask.Licenses.%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../LICENSE" LogicalName="MiniTask.Licenses.0-MiniTask.txt" /></ItemGroup>
</Project>
