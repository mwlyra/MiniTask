<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>MiniTask</AssemblyName><RootNamespace>MiniTask.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>MiniTask.ico</ApplicationIcon>
    <Version>1.1.2</Version><Description>MiniTask local Windows macro recorder</Description>
    <PlatformTarget>x64</PlatformTarget><PublishTrimmed>false</PublishTrimmed>
    <!-- WPF owns startup/DPI. WinForms is used only for NotifyIcon, with no Application.Run. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../MiniTask.Windows/MiniTask.Windows.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="MiniTask.ico" /></ItemGroup>
</Project>
